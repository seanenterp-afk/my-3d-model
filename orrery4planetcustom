<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>4 Planet Custom Orrery</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: transparent; font-family: sans-serif; }
  .wrap { background: #0a0a14; border-radius: 16px; overflow: hidden; }
  .page { display: none; }
  .page.active { display: flex; min-height: 620px; }
  .left-panel { width: 45%; position: relative; border-right: 0.5px solid rgba(255,255,255,0.07); overflow: hidden; background: #000; display: flex; flex-direction: column; }
  .right-panel { width: 55%; padding: 2rem 1.75rem; overflow-y: auto; display: flex; flex-direction: column; }
  .stars { position: absolute; inset: 0; z-index: 0; background: radial-gradient(ellipse at center, #0d1b2a 0%, #000005 100%); }
  .stars::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(1px 1px at 10% 15%,#fff 100%,transparent),radial-gradient(1px 1px at 25% 60%,#fff 100%,transparent),radial-gradient(1.5px 1.5px at 40% 30%,#fff 100%,transparent),radial-gradient(1px 1px at 55% 75%,#fff 100%,transparent),radial-gradient(1px 1px at 70% 10%,#fff 100%,transparent),radial-gradient(1.5px 1.5px at 80% 50%,#fff 100%,transparent),radial-gradient(1px 1px at 90% 85%,#fff 100%,transparent),radial-gradient(1px 1px at 15% 90%,#fff 100%,transparent); opacity: 1; }
  .stars::after { content: ''; position: absolute; inset: 0; background-image: radial-gradient(1px 1px at 8% 22%,#aad4ff 100%,transparent),radial-gradient(1px 1px at 30% 80%,#aad4ff 100%,transparent),radial-gradient(1px 1px at 52% 48%,#ffd6aa 100%,transparent),radial-gradient(1px 1px at 68% 35%,#aad4ff 100%,transparent); opacity: 1; animation: twinkle 4s ease-in-out infinite alternate; }
  @keyframes twinkle { 0%{opacity:0.7} 100%{opacity:1} }
  .glow-ring { position: absolute; inset: 0; z-index: 2; pointer-events: none; box-shadow: inset 0 0 40px rgba(255,255,255,0.02),0 0 30px rgba(180,210,255,0.08); }
  #modelCanvas { display: block; width: 100%; flex: 1; cursor: grab; touch-action: none; position: relative; z-index: 1; min-height: 240px; }
  #modelCanvas:active { cursor: grabbing; }
  .zoom-hint { position: absolute; bottom: 0; left: 0; right: 0; text-align: center; color: rgba(255,255,255,0.18); font-size: 10px; padding-bottom: 4px; z-index: 3; letter-spacing: 0.04em; pointer-events: none; }
  .control-panel { position: relative; z-index: 3; background: rgba(255,255,255,0.04); border-top: 0.5px solid rgba(255,255,255,0.08); padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
  .panel-top-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px; }
  .panel-section-label { font-size: 10px; color: rgba(255,255,255,0.3); text-transform: uppercase; letter-spacing: 0.08em; }
  .snap-link { background: none; border: none; color: #fff; font-size: 12px; cursor: pointer; font-family: sans-serif; padding: 0; opacity: 0.8; transition: opacity 0.2s; }
  .snap-link:hover { opacity: 1; }
  .snap-link.snapping { opacity: 0.5; }
  .tex-row { display: flex; align-items: center; gap: 8px; }
  .tex-row span { font-size: 10px; color: rgba(255,255,255,0.35); width: 38px; flex-shrink: 0; letter-spacing: 0.04em; }
  .tex-row input[type=range] { flex: 1; accent-color: rgba(255,255,255,0.6); height: 2px; }
  .tex-val { font-size: 10px; color: rgba(255,255,255,0.3); width: 28px; text-align: right; flex-shrink: 0; }
  .active-indicator { display: flex; align-items: center; justify-content: space-between; padding: 6px 12px 8px; position: relative; z-index: 3; }
  .active-dots { display: flex; gap: 8px; }
  .active-dot { width: 8px; height: 8px; border-radius: 50%; opacity: 0.3; transition: opacity 0.2s, transform 0.2s; cursor: pointer; }
  .active-dot.active { opacity: 1; transform: scale(1.3); }
  .panel-hint { color: rgba(255,255,255,0.2); font-size: 10px; letter-spacing: 0.04em; }
  .form-title { color: #fff; font-size: 20px; font-weight: 500; margin-bottom: 0.3rem; }
  .form-sub { color: rgba(255,255,255,0.4); font-size: 13px; margin-bottom: 1.4rem; }
  .divider { width: 32px; height: 1px; background: rgba(255,255,255,0.15); margin-bottom: 1.4rem; }
  .field { margin-bottom: 1.1rem; }
  .field label { display: block; color: rgba(255,255,255,0.55); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px; }
  .field input[type=text], .field input[type=email] { width: 100%; background: rgba(255,255,255,0.05); border: 0.5px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 10px 12px; color: #fff; font-size: 13px; font-family: sans-serif; outline: none; transition: border-color 0.2s; }
  .field input:focus { border-color: rgba(255,255,255,0.4); }
  .field input.error { border-color: #e05555; }
  .field input.valid { border-color: #4caf7d; }
  .field-error { color: #e05555; font-size: 11px; margin-top: 5px; display: none; }
  .field-error.visible { display: block; }
  .upload-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .upload-slot { background: rgba(255,255,255,0.04); border: 0.5px dashed rgba(255,255,255,0.18); border-radius: 10px; padding: 0.9rem 0.8rem; text-align: center; cursor: pointer; transition: border-color 0.2s, background 0.2s, box-shadow 0.2s; position: relative; overflow: hidden; }
  .upload-slot:hover { border-color: rgba(255,255,255,0.35); background: rgba(255,255,255,0.06); }
  .upload-slot.has-file { border-style: solid; }
  .upload-slot.selected { box-shadow: 0 0 0 1.5px #fff; border-style: solid; }
  .upload-slot input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
  .slot-planet-dot { width: 18px; height: 18px; border-radius: 50%; margin: 0 auto 5px; transition: transform 0.2s; }
  .upload-slot.selected .slot-planet-dot { transform: scale(1.2); }
  .slot-label { color: rgba(255,255,255,0.4); font-size: 11px; }
  .slot-name { color: rgba(255,255,255,0.7); font-size: 10px; margin-top: 3px; word-break: break-all; }
  .preview-img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; margin: 0 auto 4px; display: block; }
  .viewing-badge { display: none; position: absolute; top: 5px; right: 5px; background: rgba(255,255,255,0.12); border-radius: 3px; font-size: 9px; color: rgba(255,255,255,0.7); padding: 2px 4px; pointer-events: none; }
  .upload-slot.selected .viewing-badge { display: block; }
  .btn-row { margin-top: auto; padding-top: 1.2rem; display: flex; gap: 8px; }
  .btn-primary { flex: 1; background: #fff; color: #0a0a14; border: none; border-radius: 8px; padding: 12px; font-size: 14px; font-weight: 500; cursor: pointer; font-family: sans-serif; transition: opacity 0.2s; }
  .btn-primary:hover { opacity: 0.88; }
  .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-secondary { flex: 1; background: transparent; color: rgba(255,255,255,0.6); border: 0.5px solid rgba(255,255,255,0.2); border-radius: 8px; padding: 12px; font-size: 14px; cursor: pointer; font-family: sans-serif; transition: background 0.2s; }
  .btn-secondary:hover { background: rgba(255,255,255,0.05); }
  .note { color: rgba(255,255,255,0.25); font-size: 11px; text-align: center; margin-top: 0.6rem; }
  .review-page { flex-direction: column; padding: 2rem; background: #0a0a14; min-height: 620px; }
  .review-title { color: #fff; font-size: 20px; font-weight: 500; text-align: center; margin-bottom: 0.3rem; }
  .review-sub { color: rgba(255,255,255,0.4); font-size: 13px; text-align: center; margin-bottom: 1.5rem; }
  .models-row { display: flex; gap: 12px; justify-content: center; margin-bottom: 1.5rem; }
  .model-card { flex: 1; max-width: 160px; background: #000; border-radius: 12px; overflow: hidden; border: 0.5px solid rgba(255,255,255,0.08); display: flex; flex-direction: column; }
  .model-card canvas { display: block; width: 100%; aspect-ratio: 1; }
  .model-card-label { color: rgba(255,255,255,0.45); font-size: 11px; text-align: center; padding: 6px 0 8px; }
  .review-fields { background: rgba(255,255,255,0.03); border: 0.5px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 1rem 1.2rem; margin-bottom: 1.5rem; }
  .review-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 0.5px solid rgba(255,255,255,0.06); font-size: 13px; }
  .review-row:last-child { border-bottom: none; }
  .review-row span:first-child { color: rgba(255,255,255,0.4); }
  .review-row span:last-child { color: #fff; word-break: break-all; text-align: right; padding-left: 1rem; }
  .success-msg { display: none; text-align: center; padding: 3rem 1rem; }
  .success-msg h3 { color: #fff; font-size: 18px; font-weight: 500; margin: 1rem 0 0.5rem; }
  .success-msg p { color: rgba(255,255,255,0.5); font-size: 13px; }
  .check-circle { width: 48px; height: 48px; border-radius: 50%; background: rgba(255,255,255,0.1); margin: 0 auto; display: flex; align-items: center; justify-content: center; }
  .submitting-msg { color: rgba(255,255,255,0.4); font-size: 12px; text-align: center; margin-top: 0.5rem; display: none; }
</style>
</head>
<body>
<div class="wrap">
  <div class="page active" id="page1">
    <div class="left-panel">
      <div class="stars"></div>
      <div class="glow-ring"></div>
      <canvas id="modelCanvas"></canvas>
      <div class="zoom-hint">scroll to zoom · drag to rotate</div>
      <div class="control-panel">
        <div class="panel-top-row">
          <span class="panel-section-label">texture controls</span>
          <button class="snap-link" id="snapBtn" onclick="snapToFront()">snap to front view</button>
        </div>
        <div class="tex-row"><span>rotate</span><input type="range" id="ctrlRotate" min="0" max="360" step="1" value="0" oninput="updateTex()"><span class="tex-val" id="valRotate">0°</span></div>
        <div class="tex-row"><span>size</span><input type="range" id="ctrlScale" min="0.1" max="2" step="0.01" value="1" oninput="updateTex()"><span class="tex-val" id="valScale">1.0</span></div>
        <div class="tex-row"><span>offset X</span><input type="range" id="ctrlX" min="-1" max="1" step="0.01" value="0" oninput="updateTex()"><span class="tex-val" id="valX">0</span></div>
        <div class="tex-row"><span>offset Y</span><input type="range" id="ctrlY" min="-1" max="1" step="0.01" value="0" oninput="updateTex()"><span class="tex-val" id="valY">0</span></div>
      </div>
      <div class="active-indicator">
        <div class="active-dots">
          <div class="active-dot active" style="background:#e8a87c" onclick="selectSlot(0)"></div>
          <div class="active-dot" style="background:#7cb9e8" onclick="selectSlot(1)"></div>
          <div class="active-dot" style="background:#b8e87c" onclick="selectSlot(2)"></div>
          <div class="active-dot" style="background:#e87cb8" onclick="selectSlot(3)"></div>
        </div>
        <div class="panel-hint" id="panelHint">click slot to preview</div>
      </div>
    </div>
    <div class="right-panel">
      <h2 class="form-title">4 Planet Custom Orrery</h2>
      <p class="form-sub">Upload your planet images and preview them on the model</p>
      <div class="divider"></div>
      <div class="field">
        <label>Your name</label>
        <input type="text" id="f-name" placeholder="Full name" oninput="validateName()"/>
        <div class="field-error" id="err-name">Please enter your name</div>
      </div>
      <div class="field">
        <label>Email address</label>
        <input type="email" id="f-email" placeholder="you@example.com" oninput="validateEmail()" onblur="validateEmail()"/>
        <div class="field-error" id="err-email">Please enter a valid email address</div>
      </div>
      <div class="field">
        <label>Planet images — upload 4</label>
        <div class="upload-grid">
          <div class="upload-slot selected" id="slot0" onclick="selectSlot(0)"><div class="viewing-badge">viewing</div><input type="file" accept="image/*" onchange="handleFile(0,this)" onclick="event.stopPropagation()"><div class="slot-planet-dot" id="dot0" style="background:#e8a87c"></div><div class="slot-label">Planet 1</div><div class="slot-name" id="name0"></div></div>
          <div class="upload-slot" id="slot1" onclick="selectSlot(1)"><div class="viewing-badge">viewing</div><input type="file" accept="image/*" onchange="handleFile(1,this)" onclick="event.stopPropagation()"><div class="slot-planet-dot" id="dot1" style="background:#7cb9e8"></div><div class="slot-label">Planet 2</div><div class="slot-name" id="name1"></div></div>
          <div class="upload-slot" id="slot2" onclick="selectSlot(2)"><div class="viewing-badge">viewing</div><input type="file" accept="image/*" onchange="handleFile(2,this)" onclick="event.stopPropagation()"><div class="slot-planet-dot" id="dot2" style="background:#b8e87c"></div><div class="slot-label">Planet 3</div><div class="slot-name" id="name2"></div></div>
          <div class="upload-slot" id="slot3" onclick="selectSlot(3)"><div class="viewing-badge">viewing</div><input type="file" accept="image/*" onchange="handleFile(3,this)" onclick="event.stopPropagation()"><div class="slot-planet-dot" id="dot3" style="background:#e87cb8"></div><div class="slot-label">Planet 4</div><div class="slot-name" id="name3"></div></div>
        </div>
      </div>
      <div class="btn-row"><button class="btn-primary" onclick="goToReview()">Review my order →</button></div>
      <p class="note">We'll be in touch within 1–2 business days</p>
    </div>
  </div>

  <div class="page review-page" id="page2">
    <div id="reviewContent">
      <h2 class="review-title">Review your order</h2>
      <p class="review-sub">Your 4 planets — confirm everything looks right</p>
      <div class="models-row" id="modelsRow"></div>
      <div class="review-fields" id="reviewFields"></div>
      <div class="btn-row" style="padding-top:0;margin-top:auto;">
        <button class="btn-secondary" onclick="goBack()">← Go back</button>
        <button class="btn-primary" id="submitBtn" onclick="submitOrder()">Submit order</button>
      </div>
      <div class="submitting-msg" id="submittingMsg">Sending your order...</div>
    </div>
    <div class="success-msg" id="successMsg">
      <div class="check-circle"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg></div>
      <h3>Order received</h3>
      <p>Thanks! We'll be in touch shortly to arrange your planet image files.</p>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
  var WEB3FORMS_KEY='ab6f3dc8-f0a0-4089-8df8-7bcb430975b3';
  var FRONT_X=0,FRONT_Y=30*Math.PI/180,FRONT_Z=0;
  var MIN_Z=2,MAX_Z=8,DEFAULT_Z=5;
  var GLB_URL='https://cdn.jsdelivr.net/gh/seanenterp-afk/my-3d-model@main/Untitled.glb';
  var canvas=document.getElementById('modelCanvas');
  var model=null,autoRotate=true,idleTimer,snapAnim=false,activeSlot=0;
  var planetTextures=[null,null,null,null];
  var planetDataURLs=[null,null,null,null];
  var fileNames=[null,null,null,null];
  var texSettings=[{rotate:0,scale:1,x:0,y:0},{rotate:0,scale:1,x:0,y:0},{rotate:0,scale:1,x:0,y:0},{rotate:0,scale:1,x:0,y:0}];

  function isValidEmail(v){return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim());}

  window.validateName=function(){
    var inp=document.getElementById('f-name');
    var ok=inp.value.trim().length>0;
    inp.classList.toggle('error',!ok);inp.classList.toggle('valid',ok);
    document.getElementById('err-name').classList.toggle('visible',!ok);
    return ok;
  };

  window.validateEmail=function(){
    var inp=document.getElementById('f-email');
    var val=inp.value.trim();
    var ok=isValidEmail(val);
    var empty=val.length===0;
    inp.classList.toggle('error',!ok&&!empty);inp.classList.toggle('valid',ok);
    document.getElementById('err-email').classList.toggle('visible',!ok&&!empty);
    return ok;
  };

  var renderer=new THREE.WebGLRenderer({canvas:canvas,antialias:true,alpha:true});
  renderer.setPixelRatio(window.devicePixelRatio);
  renderer.outputEncoding=THREE.sRGBEncoding;
  renderer.shadowMap.enabled=false;
  var scene=new THREE.Scene();
  var camera=new THREE.PerspectiveCamera(45,1,0.1,100);
  camera.position.z=DEFAULT_Z;
  scene.add(new THREE.AmbientLight(0xffffff,3.0));
  var d1=new THREE.DirectionalLight(0xffffff,0.5);d1.position.set(5,5,5);d1.castShadow=false;scene.add(d1);
  var d2=new THREE.DirectionalLight(0xffffff,0.5);d2.position.set(-5,-3,-5);scene.add(d2);
  var d3=new THREE.DirectionalLight(0xffffff,0.4);d3.position.set(0,10,0);scene.add(d3);

  function resizeRenderer(){var w=canvas.clientWidth,h=canvas.clientHeight;if(w>0&&h>0){renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix();}}
  function lerpAngle(a,b,t){var d=b-a;while(d>Math.PI)d-=Math.PI*2;while(d<-Math.PI)d+=Math.PI*2;return a+d*t;}

  function animate(){
    requestAnimationFrame(animate);
    if(snapAnim&&model){
      model.rotation.x=lerpAngle(model.rotation.x,FRONT_X,0.12);
      model.rotation.y=lerpAngle(model.rotation.y,FRONT_Y,0.12);
      model.rotation.z=lerpAngle(model.rotation.z,FRONT_Z,0.12);
      if(Math.abs(model.rotation.x-FRONT_X)<0.001&&Math.abs(model.rotation.y-FRONT_Y)<0.001&&Math.abs(model.rotation.z-FRONT_Z)<0.001){
        model.rotation.set(FRONT_X,FRONT_Y,FRONT_Z);snapAnim=false;autoRotate=false;
        var btn=document.getElementById('snapBtn');btn.classList.remove('snapping');btn.textContent='snap to front view';
      }
    } else if(autoRotate&&model){model.rotation.y+=0.002;}
    resizeRenderer();renderer.render(scene,camera);
  }
  animate();

  canvas.addEventListener('wheel',function(e){e.preventDefault();camera.position.z=Math.min(MAX_Z,Math.max(MIN_Z,camera.position.z+e.deltaY*0.01));},{passive:false});

  window.snapToFront=function(){if(!model)return;autoRotate=false;snapAnim=true;clearTimeout(idleTimer);var btn=document.getElementById('snapBtn');btn.classList.add('snapping');btn.textContent='snapping...';};

  function applyTextureToModel(m,tex){if(!m)return;m.traverse(function(c){if(c.isMesh){c.material.map=tex;c.material.color.set(tex?0xffffff:0xcccccc);c.material.needsUpdate=true;}});}

  function applySettings(idx){
    var t=planetTextures[idx];if(!t)return;
    var s=texSettings[idx];
    t.wrapS=THREE.ClampToEdgeWrapping;t.wrapT=THREE.ClampToEdgeWrapping;
    t.repeat.set(s.scale,s.scale);t.offset.set(s.x*(1-s.scale),s.y*(1-s.scale));
    t.rotation=s.rotate*Math.PI/180;t.center.set(0.5,0.5);t.needsUpdate=true;
  }

  window.updateTex=function(){
    var s=texSettings[activeSlot];
    s.rotate=parseFloat(document.getElementById('ctrlRotate').value);
    s.scale=parseFloat(document.getElementById('ctrlScale').value);
    s.x=parseFloat(document.getElementById('ctrlX').value);
    s.y=parseFloat(document.getElementById('ctrlY').value);
    document.getElementById('valRotate').textContent=Math.round(s.rotate)+'°';
    document.getElementById('valScale').textContent=s.scale.toFixed(1);
    document.getElementById('valX').textContent=s.x.toFixed(2);
    document.getElementById('valY').textContent=s.y.toFixed(2);
    applySettings(activeSlot);
    if(model)applyTextureToModel(model,planetTextures[activeSlot]);
  };

  function loadSlotControls(idx){
    var s=texSettings[idx];
    document.getElementById('ctrlRotate').value=s.rotate;document.getElementById('ctrlScale').value=s.scale;
    document.getElementById('ctrlX').value=s.x;document.getElementById('ctrlY').value=s.y;
    document.getElementById('valRotate').textContent=Math.round(s.rotate)+'°';
    document.getElementById('valScale').textContent=s.scale.toFixed(1);
    document.getElementById('valX').textContent=s.x.toFixed(2);document.getElementById('valY').textContent=s.y.toFixed(2);
  }

  window.selectSlot=function(idx){
    activeSlot=idx;
    document.querySelectorAll('.upload-slot').forEach(function(s,i){s.classList.toggle('selected',i===idx);});
    document.querySelectorAll('.active-dot').forEach(function(d,i){d.classList.toggle('active',i===idx);});
    loadSlotControls(idx);
    if(planetTextures[idx]){applyTextureToModel(model,planetTextures[idx]);applySettings(idx);document.getElementById('panelHint').textContent='planet '+(idx+1)+' previewing';}
    else{applyTextureToModel(model,null);document.getElementById('panelHint').textContent='no image yet';}
  };

  window.handleFile=function(idx,input){
    var file=input.files[0];if(!file)return;
    fileNames[idx]=file.name;
    var slot=document.getElementById('slot'+idx);
    slot.classList.add('has-file');
    document.getElementById('name'+idx).textContent=file.name.length>16?file.name.substring(0,14)+'...':file.name;
    var reader=new FileReader();
    reader.onload=function(e){
      planetDataURLs[idx]=e.target.result;
      var old=slot.querySelector('.preview-img');if(old)old.remove();
      var img=document.createElement('img');img.className='preview-img';img.src=e.target.result;
      var dot=document.getElementById('dot'+idx);if(dot){dot.style.display='none';slot.insertBefore(img,dot);}
      var texLoader=new THREE.TextureLoader();
      texLoader.load(e.target.result,function(tex){
        tex.encoding=THREE.sRGBEncoding;tex.wrapS=THREE.ClampToEdgeWrapping;tex.wrapT=THREE.ClampToEdgeWrapping;
        planetTextures[idx]=tex;
        if(activeSlot===idx){applyTextureToModel(model,tex);applySettings(idx);document.getElementById('panelHint').textContent='planet '+(idx+1)+' previewing';}
      });
    };
    reader.readAsDataURL(file);selectSlot(idx);snapToFront();
  };

  var isDragging=false,prevX=0,prevY=0;
  canvas.addEventListener('mousedown',function(e){isDragging=true;autoRotate=false;snapAnim=false;prevX=e.clientX;prevY=e.clientY;});
  window.addEventListener('mousemove',function(e){if(!isDragging||!model)return;model.rotation.y+=(e.clientX-prevX)*0.01;model.rotation.x+=(e.clientY-prevY)*0.01;prevX=e.clientX;prevY=e.clientY;});
  window.addEventListener('mouseup',function(){isDragging=false;clearTimeout(idleTimer);idleTimer=setTimeout(function(){autoRotate=true;},3000);});
  canvas.addEventListener('touchstart',function(e){isDragging=true;autoRotate=false;snapAnim=false;prevX=e.touches[0].clientX;prevY=e.touches[0].clientY;},{passive:true});
  canvas.addEventListener('touchmove',function(e){if(!isDragging||!model)return;model.rotation.y+=(e.touches[0].clientX-prevX)*0.01;model.rotation.x+=(e.touches[0].clientY-prevY)*0.01;prevX=e.touches[0].clientX;prevY=e.touches[0].clientY;},{passive:true});
  canvas.addEventListener('touchend',function(){isDragging=false;});

  var miniRenderers=[],miniScenes=[],miniCameras=[],miniModels=[];
  var miniAnimRunning=false;

  function buildMiniViewers(){
    var row=document.getElementById('modelsRow');row.innerHTML='';
    miniRenderers.length=0;miniScenes.length=0;miniCameras.length=0;miniModels.length=0;
    for(var i=0;i<4;i++){
      var card=document.createElement('div');card.className='model-card';
      var cv=document.createElement('canvas');card.appendChild(cv);
      var lbl=document.createElement('div');lbl.className='model-card-label';lbl.textContent='Planet '+(i+1);card.appendChild(lbl);
      row.appendChild(card);
      var r=new THREE.WebGLRenderer({canvas:cv,antialias:true,alpha:true});
      r.setPixelRatio(window.devicePixelRatio);r.outputEncoding=THREE.sRGBEncoding;r.shadowMap.enabled=false;
      miniRenderers.push(r);
      var s=new THREE.Scene();
      s.add(new THREE.AmbientLight(0xffffff,3.0));
      var dl=new THREE.DirectionalLight(0xffffff,0.5);dl.position.set(5,5,5);s.add(dl);
      var dl2=new THREE.DirectionalLight(0xffffff,0.5);dl2.position.set(-5,-3,-5);s.add(dl2);
      miniScenes.push(s);
      var cam=new THREE.PerspectiveCamera(45,1,0.1,100);cam.position.z=4;miniCameras.push(cam);
      miniModels.push(null);
    }
    if(!miniAnimRunning){
      miniAnimRunning=true;
      (function miniLoop(){
        requestAnimationFrame(miniLoop);
        for(var i=0;i<4;i++){
          var cv=miniRenderers[i].domElement;
          var w=cv.clientWidth,h=cv.clientHeight||w;
          if(w>0&&h>0){miniRenderers[i].setSize(w,h,false);miniCameras[i].aspect=w/h;miniCameras[i].updateProjectionMatrix();}
          if(miniModels[i])miniModels[i].rotation.y+=0.003;
          miniRenderers[i].render(miniScenes[i],miniCameras[i]);
        }
      })();
    }
    var loader=new THREE.GLTFLoader();
    for(var i=0;i<4;i++){
      (function(idx){
        loader.load(GLB_URL,function(gltf){
          var fresh=gltf.scene;
          var box=new THREE.Box3().setFromObject(fresh);
          var center=box.getCenter(new THREE.Vector3());
          var size=box.getSize(new THREE.Vector3());
          fresh.position.sub(center);fresh.scale.setScalar(2/Math.max(size.x,size.y,size.z));
          fresh.rotation.set(FRONT_X,FRONT_Y,FRONT_Z);
          fresh.traverse(function(c){
            if(c.isMesh){
              c.material=c.material.clone();
              if(planetTextures[idx]){var t=planetTextures[idx].clone();t.needsUpdate=true;c.material.map=t;c.material.color.set(0xffffff);}
              else{c.material.map=null;c.material.color.set(0xcccccc);}
              c.material.needsUpdate=true;
            }
          });
          miniScenes[idx].add(fresh);miniModels[idx]=fresh;
        });
      })(i);
    }
  }

  window.goToReview=function(){
    var nameOk=validateName(),emailOk=validateEmail();
    if(!nameOk){document.getElementById('f-name').classList.add('error');document.getElementById('err-name').classList.add('visible');}
    if(!emailOk){document.getElementById('f-email').classList.add('error');document.getElementById('err-email').classList.add('visible');}
    if(!nameOk||!emailOk)return;
    var name=document.getElementById('f-name').value.trim();
    var email=document.getElementById('f-email').value.trim();
    var uploadedNames=fileNames.map(function(n){return n||'not uploaded';}).join(', ');
    document.getElementById('reviewFields').innerHTML=
      '<div class="review-row"><span>Name</span><span>'+name+'</span></div>'+
      '<div class="review-row"><span>Email</span><span>'+email+'</span></div>'+
      '<div class="review-row"><span>Planet files</span><span>'+uploadedNames+'</span></div>';
    document.getElementById('page1').classList.remove('active');
    document.getElementById('page2').classList.add('active');
    buildMiniViewers();
  };

  window.goBack=function(){document.getElementById('page2').classList.remove('active');document.getElementById('page1').classList.add('active');};

  window.submitOrder=function(){
    var name=document.getElementById('f-name').value.trim();
    var email=document.getElementById('f-email').value.trim();
    var btn=document.getElementById('submitBtn');
    var msg=document.getElementById('submittingMsg');
    btn.disabled=true;msg.style.display='block';
    var data={
      access_key:WEB3FORMS_KEY,
      subject:'New Custom Orrery Order — '+name,
      name:name,email:email,
      'Planet 1 filename':fileNames[0]||'not uploaded',
      'Planet 2 filename':fileNames[1]||'not uploaded',
      'Planet 3 filename':fileNames[2]||'not uploaded',
      'Planet 4 filename':fileNames[3]||'not uploaded',
      message:'New 4 Planet Custom Orrery order from '+name+' ('+email+'). Files: 1='+fileNames[0]+', 2='+fileNames[1]+', 3='+fileNames[2]+', 4='+fileNames[3]
    };
    fetch('https://api.web3forms.com/submit',{
      method:'POST',
      headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify(data)
    }).then(function(r){return r.json();}).then(function(res){
      msg.style.display='none';
      if(res.success){document.getElementById('reviewContent').style.display='none';document.getElementById('successMsg').style.display='block';}
      else{btn.disabled=false;alert('Something went wrong. Please try again.');}
    }).catch(function(){msg.style.display='none';btn.disabled=false;alert('Could not send order. Please check your connection and try again.');});
  };

  var ls=document.createElement('script');
  ls.src='https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js';
  ls.onload=function(){
    var loader=new THREE.GLTFLoader();
    loader.load(GLB_URL,function(gltf){
      model=gltf.scene;
      var box=new THREE.Box3().setFromObject(model);
      var center=box.getCenter(new THREE.Vector3());
      var size=box.getSize(new THREE.Vector3());
      model.position.sub(center);model.scale.setScalar(2/Math.max(size.x,size.y,size.z));
      model.rotation.set(FRONT_X,FRONT_Y,FRONT_Z);
      scene.add(model);
    },undefined,function(err){console.error(err);});
  };
  document.head.appendChild(ls);
})();
</script>
